

# GitHub token — optional for public repos, required for private repos
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# LLM backend — only needed when running triage.py STANDALONE
# (i.e. without Gemini CLI or another agent driving it).
# When using Gemini CLI, Claude, Kiro etc. — leave these blank.
# ---------------------------------------------------------------------------
MODEL_PROVIDER=google          # openai | google
MODEL_API_KEY=                 # Gemini API key or OpenAI key (standalone only)
MODEL_NAME=gemini-1.5-flash    # model name (standalone only)

